{
  "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": "biome check --error-on-warnings --no-errors-on-unmatched",
  "*.{md,yml,yaml}": "prettier --check",
  "*.nix": "nixfmt --check",
  ".github/workflows/*.{yml,yaml}": "actionlint",
  "{scripts/*.sh,examples/*.sh,.husky/pre-commit,.husky/pre-push}": [
    "shfmt -d",
    "shellcheck --shell=sh"
  ]
}
